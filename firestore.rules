rules_version = '2';

// =============================================================================
// ⚠️ 이 파일을 고치기 전에 반드시 읽을 것 — 이 프로젝트를 반복해서 물어뜯은 함정
// =============================================================================
//
// [1] 없는 필드에 점(.) 표기로 접근하면 요청 **전체**가 permission-denied가 된다.
//
//     resource.data.someField            ← 문서에 someField가 없으면 규칙이
//                                          "속성을 찾을 수 없음" 에러로 터지고,
//                                          그 요청은 통째로 거부된다.
//     resource.data.get('someField', null)  ← 없으면 null. 이렇게 쓴다.
//
//     "그럴 리 없다"고 넘기지 말 것 — 이 프로젝트에서만 세 번 터졌다:
//       · storyPacks 문서 레벨: 예전에 만들어진 팩에 authorId/type/genres/
//         price가 아예 없어서 메타데이터 승인이 전부 실패했다.
//       · authorApplications: 콘솔에서 손으로 만든 문서에 검토 필드가 없었다.
//       · nodes의 approveNode/rejectNode: blocks 스키마 마이그레이션으로
//         title/day/body/bgImageId가 사라졌는데 규칙이 그 이름을 점 표기로
//         비교하고 있어서, 모든 승인/반려가 permission-denied로 죽었다.
//
//     중간에 추가된 필드는 **옛 문서에 없다**(백필하지 않았다):
//       storyPacks.createdAt / users.createdAt / users.accountDisabled /
//       suspended·suspendedReason·suspendedAt·suspendedBy /
//       liveMetadata의 price·salePrice·discountStartAt·discountEndAt·
//       defaultBgmId·defaultTtsVoiceId
//     이 필드들은 예외 없이 get(key, null)로 읽는다.
//
//     유일한 예외는 아래 nodes의 `resource.data.status`다 — 쿼리 안전성 증명
//     때문에 일부러 점 표기를 쓴다(그 자리 주석에 이유를 적어 뒀다).
//
// [2] 규칙은 필터가 아니다(rules are not filters).
//
//     Firestore는 쿼리 결과를 규칙으로 걸러 주지 않는다. "쿼리 제약만 보고
//     규칙이 반드시 만족됨"이 증명돼야 쿼리가 통과한다 — 규칙이 참조하는
//     필드를 쿼리가 제약하지 않으면 **쿼리 전체가 거부된다**(문서 하나하나가
//     아니라).
//
//     그래서 아래 nodes 규칙의 `resource.data.status == 'published'`는
//     클라이언트 쿼리의 `.where('status','==','published')`와 글자 그대로
//     짝이 맞아야 한다. 한쪽만 고치면 리더가 통째로 깨진다.
//
// [3] collectionGroup 쿼리는 {path=**} 형태의 재귀 규칙으로만 허용된다.
//
//     중첩 match(/storyPacks/{packId}/nodes/{nodeId})는 상위 경로를 아는
//     직접 접근에만 적용된다. collectionGroup('nodes')/collectionGroup(
//     'transactions')은 아래쪽 {path=**} 규칙이 따로 커버한다 — 그리고 그
//     규칙은 packId/userId를 캡처할 수 없으므로 소유권 기반 조건을 쓸 수
//     없다. 이 비대칭이 지금 남아 있는 유료 콘텐츠 구멍의 원인이다
//     ({path=**}/nodes 주석 참고).
//
// [4] Admin SDK(Cloud Functions)는 이 파일을 통째로 우회한다.
//
//     functions/src/index.ts의 모든 함수는 규칙 검사를 받지 않는다. 따라서
//     "규칙에서 막았으니 안전하다"는 Cloud Function에는 해당하지 않는다 —
//     함수마다 자기 인가를 직접 해야 한다. synthesizeNodeTts에 구매 확인이
//     없던 게 정확히 그 이유로 생긴 구멍이었다.
//
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 공용 헬퍼
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(myUid()))
        ? get(/databases/$(database)/documents/users/$(myUid())).data.role
        : 'reader';
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function isAuthorOrAdmin() {
      return myRole() == 'author' || myRole() == 'admin';
    }

    function isPackOwnedBy(packId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/storyPacks/$(packId)).data.authorId == myUid();
    }

    // isPackOwnedBy(packId)는 "이 팩을 쓴 작가인가"를 묻는다(작가 편집 권한) —
    // 아래 둘은 완전히 다른 질문, "이 독자가 이 팩을 리뷰/댓글 달 자격이
    // 있는가"를 묻는다. 구매 여부는 GameState.ownedPackIds가 users/{uid}/
    // save/current에 저장하는 배열을 그대로 본다(리더 쪽 GameState.toJson()
    // 참고).
    function readerOwnsPack(packId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(myUid())/save/current)
        && packId in get(/databases/$(database)/documents/users/$(myUid())/save/current).data.get('ownedPackIds', []);
    }

    // price/salePrice/discountStartAt/discountEndAt는 title/genres/description/
    // coverImageId와 같은 메타데이터 승인 게이트를 탄다 — 작가가 draft로 자유롭게
    // 고쳐도(saveDraftPackSettings/requestMetadataEdit) 독자에게 실제로 보이는/
    // 적용되는 값은 오직 admin이 승인해서 liveMetadata에 복사한 스냅샷뿐이다.
    // 그래서 이 함수는 top-level 필드가 아니라 반드시 liveMetadata를 읽는다 —
    // top-level을 읽으면 작가가 승인 없이 즉시 가격을 바꿀 수 있게 되어 버린다
    // (title/genres를 top-level에서 바로 읽지 않는 것과 같은 이유).
    // 연재 시작 승인을 아직 못 받아 liveMetadata 자체가 없는 팩은 0(무료)으로
    // 본다.
    function effectivePrice(packId) {
      let live = get(/databases/$(database)/documents/storyPacks/$(packId)).data.get('liveMetadata', null);
      let price = live == null ? 0 : live.get('price', 0);
      let salePrice = live == null ? null : live.get('salePrice', null);
      let discountStartAt = live == null ? null : live.get('discountStartAt', null);
      let discountEndAt = live == null ? null : live.get('discountEndAt', null);
      let discountActive = salePrice != null
        && (discountStartAt == null || request.time >= discountStartAt)
        && (discountEndAt == null || request.time <= discountEndAt);
      return discountActive ? salePrice : price;
    }

    function isPackFree(packId) {
      return effectivePrice(packId) <= 0;
    }

    function canReviewPack(packId) {
      return isSignedIn() && (isPackFree(packId) || readerOwnsPack(packId));
    }

    // 답글(comments 문서의 parentCommentId)이 가리키는 문서가 실제로 존재하고,
    // 그 문서 자신은 parentCommentId가 없는(= 최상위) 댓글인지 — 답글의
    // 답글을 만들 수 없게 서버에서도 막는다(클라이언트 UI가 답글에는 "답글"
    // 버튼을 안 주는 것과 별개로, 규칙에서도 강제).
    function isValidParentComment(packId, parentId) {
      return exists(/databases/$(database)/documents/storyPacks/$(packId)/comments/$(parentId))
        && get(/databases/$(database)/documents/storyPacks/$(packId)/comments/$(parentId)).data.get('parentCommentId', null) == null;
    }

    // =========================================================================
    // 사용자별 개인 문서 — users/{uid}/ 아래. 원칙적으로 본인만 접근하고,
    // "돈"에 해당하는 값(wallet.balance, save.ownedPackIds)만 Cloud Function
    // 전용으로 따로 잠근다.
    // =========================================================================

    // users/{uid}/save/{docId} — 게임 세이브 블롭 하나(GameState.toJson(),
    // CloudSaveService가 `.set()`으로 문서 전체를 통째로 덮어쓴다).
    //
    // 읽기/쓰기 모두 본인만. 다만 wallet과 달리 이 문서는 **혼합 문서**다 —
    // 대부분은 클라이언트가 자유롭게 써도 되는 게임 상태(inventory/level/exp/
    // hearts/...)지만, `ownedPackIds` 하나만은 "무엇을 돈 주고 샀는가"라는
    // 서버 권한 데이터다. 그래서 문서 전체를 잠그는 대신(그러면 세이브 자체가
    // 안 된다) 필드 하나만 잠근다.
    //
    // ⚠️ ownedPackIds를 왜 잠그는가: 이 배열이 곧 유료 팩 소유권이다. 예전엔
    // 이 match가 `allow read, write`였고, 그래서 아무 로그인 계정이나 SDK로
    // 이 문서에 ownedPackIds를 직접 써 넣어 **모든 유료 팩을 공짜로 가질 수
    // 있었다** — purchasePack/purchaseBundle Cloud Function이 코인을 차감하고
    // 거래를 기록하는 게 전부 무의미해지는 구멍이었다. 게다가 위
    // readerOwnsPack()이 바로 이 배열을 읽어 리뷰/댓글 작성 자격을 판정하므로,
    // 규칙 자신이 사용자가 조작 가능한 값을 신뢰하고 있었다.
    //
    // 정상 흐름이 안 막히는 이유: purchasePack/purchaseBundle은 Admin SDK
    // (db.doc(...).set(..., {merge:true}))로 쓰므로 이 규칙 자체를 우회한다.
    // 클라이언트는 CloudSaveService.save()가 항상 문서 전체를 set하지만,
    // 로컬 GameState.ownedPackIds는 서버 값을 그대로 미러링하고 있으므로
    // 그 키는 diff에 안 잡힌다 — 값이 실제로 달라질 때만 거부된다.
    // (구매 직후에는 requestPackPurchase가 markPackOwned()로 로컬을 먼저
    // 맞춰 두므로 다음 저장도 그대로 통과한다.)
    //
    // 잠금 방식은 storyPacks의 viewCount/suspended 규칙과 같은 affectedKeys()
    // 화이트리스트의 역(逆)이다 — "이 키들만 바뀔 수 있다"가 아니라 "이 키는
    // 절대 바뀌면 안 된다".
    match /users/{userId}/save/{saveDocId} {
      allow read: if isSignedIn() && myUid() == userId;

      // 최초 생성(CloudSyncController.loadOrInitialize의 초기 세이브)에는
      // resource가 아직 없어서 diff()를 쓸 수 없다 — 대신 "소유 목록이 채워진
      // 채로 도착하면 안 된다"로 막는다. 신규 유저는 항상 빈 배열이다.
      allow create: if isSignedIn() && myUid() == userId
        && request.resource.data.get('ownedPackIds', []).size() == 0;

      allow update: if isSignedIn() && myUid() == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['ownedPackIds']);

      // 문서를 통째로 지우면 ownedPackIds도 같이 사라진다(= 구매 이력 소멸).
      // 클라이언트에 이 문서를 지우는 코드 경로 자체가 없다.
      allow delete: if false;
    }

    // 리더 화면(SceneFrame) 표시/재생 환경설정 — save/current와 같은 "본인만
    // 읽고 쓴다" 패턴.
    match /users/{userId}/readerPrefs/{prefsDocId} {
      allow read, write: if isSignedIn() && myUid() == userId;
    }

    // 팩별 읽기 진행 상황(현재 노드/미리보기 카운트) — 문서 id == packId.
    // save/current(전역 세이브 하나)와 별개로, 팩마다 독립된 문서를 둬서
    // 한 팩을 읽다 다른 팩으로 옮겨도 서로의 위치를 안 덮어쓴다. save/
    // readerPrefs와 같은 "본인만 읽고 쓴다" 패턴.
    match /users/{userId}/readingProgress/{packId} {
      allow read, write: if isSignedIn() && myUid() == userId;
    }

    // 코인 지갑 — save/readerPrefs/readingProgress와 달리 "본인만 읽고 쓴다"가
    // 아니라 "본인만 읽는다"다. balance는 오직 confirmCoinCharge Cloud
    // Function(Admin SDK로 실행되어 이 규칙 자체를 우회한다)만 바꾼다 — 결제
    // 승인을 서버에서 검증한 뒤에만 코인을 지급하기 위해서다. write 규칙이
    // 아예 없으므로 기본값(거부)이 곧 "쓰기는 Cloud Function 전용"이다
    // (rankingSnapshots와 같은 패턴).
    match /users/{userId}/wallet/{walletDocId} {
      allow read: if isSignedIn() && myUid() == userId;

      // 거래 내역도 같은 이유로 읽기 전용 — confirmCoinCharge가 충전(charge)
      // 건을, purchasePack/purchaseBundle이 사용(purchase) 건을,
      // refundCoinCharge가 환불(refund) 건을 쓴다. 이 중첩 match는 userId를
      // 아는 직접 접근(문서 참조, 특정 유저로 좁힌 구독)에만 적용된다 —
      // admin 결제내역/코인사용내역 화면처럼 유저를 가로질러 훑는
      // collectionGroup('transactions') 쿼리는 아래 별도의 {path=**} 규칙이
      // 커버한다({path=**}/nodes와 같은 이유).
      match /transactions/{txId} {
        allow read: if isSignedIn() && myUid() == userId;
      }
    }

    // users/*/wallet/*/transactions 컬렉션 그룹 조회 전용 — admin 결제내역/
    // 코인사용내역/정산 화면이 uid를 몰라도 모든 유저의 거래를 가로질러
    // 훑을 수 있어야 한다(collectionGroup('transactions')). 위 중첩 match는
    // userId를 아는 직접 접근에만 적용되고 collectionGroup 쿼리에는 적용되지
    // 않는다 — {path=**}/nodes 규칙과 정확히 같은 이유(Firestore는
    // collection group 쿼리를 오직 {path=**} 형태의 재귀 와일드카드 규칙으로만
    // 허용한다). admin만 허용한다 — 일반 유저는 여전히 자기 uid로 좁힌
    // 직접 구독(위 중첩 match)만 쓸 수 있다.
    match /{path=**}/transactions/{txId} {
      allow read: if isAdmin();
    }

    // =========================================================================
    // 신원 · 권한 — 누가 누구인지, 무엇을 할 수 있는지. 위 헬퍼들(myRole/
    // isAdmin/isAuthorOrAdmin)이 전부 여기 users/{uid}.role을 원천으로 본다.
    // =========================================================================

    // users/{uid} — 신원/권한 문서. 읽기는 본인과 admin(admin의 "회원 관리"
    // 화면이 users 컬렉션 전체를 훑는다). 쓰기는 세 갈래로 갈린다: 최초 생성
    // (본인, 항상 reader로), admin의 자유로운 갱신(승인/반려/자격 회수),
    // 그리고 본인의 작가 신청 제출 하나뿐이다. role/authorApplicationStatus는
    // 본인이 함부로 못 바꾼다 — 승인/반려 흐름을 통해서만 바뀐다.
    //
    // accountDisabled는 여기 어느 규칙으로도 클라이언트가 쓸 수 없다 —
    // setAuthorAccountDisabled Cloud Function이 Admin SDK로만 쓰는, Firebase
    // Auth의 disabled 플래그를 비추는 거울 필드다(user_profile.dart 참고).
    match /users/{userId} {
      allow read: if isSignedIn() && (myUid() == userId || isAdmin());

      // 최초 로그인(ensureProfile) — 본인이 자기 문서를 reader로 처음 만드는 것만.
      allow create: if isSignedIn() && myUid() == userId
        && request.resource.data.role == 'reader'
        && request.resource.data.authorApplicationStatus == 'none';

      // admin은 승인/반려 처리를 위해 role/authorApplicationStatus를 자유롭게 갱신.
      allow update: if isAdmin();

      // 본인 갱신은 신청 제출(submitApplication)뿐 — role은 절대 못 바꾸고,
      // authorApplicationStatus는 none/rejected → pending으로만 바뀔 수 있다.
      //
      // ⚠️ 미해결: 이 규칙만 파일 맨 위 [1]번 함정을 그대로 밟고 있다 —
      // displayName/email/authorApplicationStatus를 점(.) 표기로 읽는다.
      // 이 필드들이 없는 문서(그 필드가 생기기 전에 만들어진 계정, 이메일을
      // 안 주는 공급자로 로그인한 계정, 콘솔에서 손으로 만든 문서)에서는
      // 규칙이 에러로 터져 **그 계정은 작가 신청을 영영 할 수 없다**.
      // 바로 아래 authorApplications 규칙은 같은 문제를 이미 get(key, null)로
      // 해결해 뒀는데 여기만 안 고쳐졌다. 고치면 동작이 바뀌는 변경이라
      // 문서화 패스에서는 손대지 않았다 — doc/codebase_audit.md 2a-5 참고.
      allow update: if isSignedIn() && myUid() == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.email == resource.data.email
        && resource.data.authorApplicationStatus in ['none', 'rejected']
        && request.resource.data.authorApplicationStatus == 'pending';
    }

    // authorApplications/{uid} — 문서 id == 신청자 uid.
    match /authorApplications/{applicantId} {
      allow read: if isSignedIn() && (myUid() == applicantId || isAdmin());

      // 신규 제출/반려 후 재신청 — 본인만, 항상 pending으로, 검토 필드는 비운 채로.
      allow create, update: if isSignedIn() && myUid() == applicantId
        && request.resource.data.uid == applicantId
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.rejectionReason == null;

      // 승인/반려 — admin만, 신청 내용 자체(uid/displayName/bio/portfolioLinks/
      // submittedAt)는 건드리지 않는다. 점(.) 표기 대신 get(key, null)을 쓴다 —
      // 필드가 아예 없는 문서(예: 콘솔에서 손으로 만든 테스트 문서)에 점 표기로
      // 접근하면 "속성을 찾을 수 없음" 에러로 요청 전체가 거부된다.
      allow update: if isAdmin()
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && request.resource.data.get('displayName', null) == resource.data.get('displayName', null)
        && request.resource.data.get('bio', null) == resource.data.get('bio', null)
        && request.resource.data.get('portfolioLinks', null) == resource.data.get('portfolioLinks', null)
        && request.resource.data.get('submittedAt', null) == resource.data.get('submittedAt', null);
    }

    // =========================================================================
    // 운영 참고 데이터 — admin이 관리하고 로그인한 누구나 읽는 컬렉션들.
    // 여섯 개(genres/homeBanners/homeEvents/pointPackages/packBundles/notices)
    // 전부 정확히 같은 모양이다: `read: isSignedIn()` + `write: isAdmin()`.
    // active/기간/플랫폼 같은 노출 필터링은 전부 클라이언트가 하므로 규칙은
    // "로그인했는지"만 본다 — 숨겨야 할 비밀이 아니라 "지금 보여줄 것"을
    // 고르는 문제이기 때문이다. 돈이 걸린 검증(가격/잔액)은 규칙이 아니라
    // 해당 Cloud Function이 Admin SDK로 원본을 다시 읽어서 한다.
    // =========================================================================

    // genres/{genreId} — admin이 관리하는 참고 데이터. 앱 재배포 없이 admin이
    // 콘솔이나(나중에 생길) 관리 UI로 추가/수정한다.
    match /genres/{genreId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // homeBanners/{bannerId} — admin이 관리하는 홈 화면 히어로 배너. genres와
    // 같은 패턴(admin만 쓰고, 로그인한 누구나 읽을 수 있다) — 리더 쪽
    // HomeBannerRepository.watchActiveBanners()가 active/기간 필터링을
    // 클라이언트에서 하므로, 규칙은 "로그인했는지"만 본다.
    match /homeBanners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // homeEvents/{eventId} — admin이 관리하는, 홈 탭이 열릴 때 뜨는 이벤트
    // 팝업. homeBanners와 같은 패턴(admin만 쓰고, 로그인한 누구나 읽을 수
    // 있다) — 리더 쪽 HomeEventRepository.watchActiveEvents()가 active/기간
    // 필터링을 클라이언트에서 하므로, 규칙은 "로그인했는지"만 본다. "오늘 이미
    // 봤는지"/"다시 보지 않기" 여부는 Firestore가 아니라 기기 로컬
    // SharedPreferences에만 저장되므로(HomeEventDismissalStore) 여기엔 그
    // 상태를 위한 필드/문서가 없다.
    match /homeEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // pointPackages/{packageId} — admin이 관리하는 충전 화면 코인 상품.
    // genres/homeBanners와 같은 패턴(admin만 쓰고, 로그인한 누구나 읽을 수
    // 있다) — 리더 쪽 PointPackageRepository.watchWebPackages()가 active/
    // platform 필터링을 클라이언트에서 하므로, 규칙은 "로그인했는지"만 본다.
    // 실제 결제 승인 시점의 가격 검증은 이 규칙과 무관하게 confirmCoinCharge
    // Cloud Function이 Admin SDK로 이 컬렉션을 직접 다시 읽어서 한다.
    match /pointPackages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // packBundles/{bundleId} — admin이 관리하는, 스토리팩 여러 개를 묶어
    // 코인으로 할인 판매하는 번들. genres/homeBanners/pointPackages와 같은
    // 패턴(admin만 쓰고, 로그인한 누구나 읽을 수 있다) — 리더 쪽
    // PackBundleRepository가 active 필터링을 클라이언트에서 하므로, 규칙은
    // "로그인했는지"만 본다. 실제 구매 시점의 가격 검증/잔액 차감/
    // ownedPackIds 부여는 이 규칙과 무관하게 purchaseBundle Cloud Function이
    // Admin SDK로 이 컬렉션을 직접 다시 읽어서 한다 — 코인 잔액(wallet)과
    // ownedPackIds에 대한 클라이언트 쓰기 권한은 여기서도 추가하지 않는다
    // (wallet은 읽기 전용, ownedPackIds는 save/current의 update 규칙이
    // affectedKeys로 잠가 뒀다 — 둘 다 이 기능 때문에 새로 넓히지 않는다).
    match /packBundles/{bundleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // notices/{noticeId} — admin이 관리하는 앱 전체 공지사항. genres/
    // homeBanners/pointPackages/packBundles와 같은 패턴(admin만 쓰고,
    // 로그인한 누구나 읽을 수 있다) — 리더 쪽 NoticeRepository가 active
    // 필터링을 클라이언트에서 하므로, 규칙은 "로그인했는지"만 본다.
    // writerNotices(작가가 자기 팩에 올리는 공지, packId 필드로 걸러 보는
    // 완전히 다른 컬렉션 — 아래 별도 match)와 혼동하지 않는다 — 이건 팩과
    // 무관한 플랫폼 전체 공지고 admin만 쓴다.
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 서버 집계 스냅샷 — 예약 실행 Cloud Function만 쓴다(Admin SDK라 이 파일을
    // 우회한다). 둘 다 write 규칙이 아예 없고, 기본값(거부)이 곧 "쓰기는
    // Cloud Function 전용"이라는 선언이다. 읽기 권한만 서로 다르다.
    // =========================================================================

    // rankingSnapshots/{date} — "YYYY-MM-DD"(KST) 문서 id, {packIds: [...]}.
    // functions/src/index.ts의 computeDailyRankingSnapshot(매일 KST 00:10
    // 예약 실행)만 쓴다 — Admin SDK로 실행되므로 이 규칙을 우회한다. 클라
    // 이언트(리더 홈 화면의 "실시간 랭킹" 섹션)는 읽기만 한다 — write 규칙이
    // 아예 없으므로 기본값(거부)이 곧 "쓰기는 Cloud Function 전용"이다.
    match /rankingSnapshots/{date} {
      allow read: if isSignedIn();
    }

    // revenueSnapshots/{date}("YYYY-MM-DD" KST) — admin "정산내역" 탭 전용
    // 일별 매출/코인 지급·사용/환불 집계. functions/src/index.ts의
    // computeDailyRevenueSnapshot(매일 KST 00:20 예약 실행)만 쓴다 — Admin
    // SDK로 실행되므로 이 규칙을 우회한다. rankingSnapshots와 달리 매출은
    // 민감한 운영 데이터라 admin만 읽는다(일반 로그인 유저는 못 읽는다).
    match /revenueSnapshots/{date} {
      allow read: if isAdmin();
    }

    // =========================================================================
    // 스토리 콘텐츠 — storyPacks와 그 하위(nodes/reviews/comments/likes),
    // 그리고 collectionGroup용 재귀 규칙. 이 파일에서 가장 복잡한 구역이다.
    //
    // 관통하는 원칙 하나: **작가가 쓴 draft와 독자가 보는 live를 규칙이
    // 분리한다.** 팩 메타데이터는 top-level(draft) / liveMetadata(승인본),
    // 노드는 top-level(draft) / liveSnapshot(승인본)으로 나뉘고, 독자에게
    // 실제로 적용되는 값(가격 판정 effectivePrice 포함)은 언제나 승인본
    // 쪽이다. 그래서 작가는 draft를 자유롭게 고칠 수 있고, 규칙은 대신
    // "승인본과 검토 필드를 클라이언트가 못 건드리게" 하는 데 집중한다.
    // =========================================================================

    // storyPacks/{packId} — 작품 한 편. 로그인한 누구나 읽는다(카탈로그/
    // 상세 화면이 제목·표지·가격을 봐야 한다 — 유료 여부와 무관하게 "무엇을
    // 파는지"는 공개 정보다). 쓰기는 다섯 갈래로 나뉘고 각각 아래에 주석이
    // 붙어 있다: 작가의 생성, 작가의 draft 저장/승인 요청, admin의 승인/반려,
    // 독자의 viewCount +1, admin의 강제 내리기/복원.
    //
    // avgRating/reviewCount는 어느 갈래로도 클라이언트가 못 쓴다 —
    // onReviewWritten Cloud Function이 Admin SDK로만 갱신한다.
    match /storyPacks/{packId} {
      allow read: if isSignedIn();

      // 생성: author/admin이 자기 자신을 authorId로 지정해서만. 항상 draft로
      // 시작한다 — 연재 시작 승인을 직접 approved로 건너뛸 수 없다.
      allow create: if isAuthorOrAdmin()
        && request.resource.data.authorId == myUid()
        && request.resource.data.serializationStatus == 'draft';

      // 작가 본인의 팩 설정 저장/승인 요청(saveDraftPackSettings,
      // requestSerialization, requestMetadataEdit) — liveMetadata와 검토
      // 관련 필드(reviewedBy/reviewedAt)는 이 경로로 절대 못 바꾼다. 그 필드는
      // 오직 admin의 승인/반려에서만 바뀐다. serializationStatus는 자기 자신을
      // 유지하거나 'pending'으로 넘어가는 것만 허용한다 — 'approved'/'rejected'로
      // 직접 바꿀 수는 없다(그건 아래 admin 규칙의 몫). pendingMetadataAction의
      // 정확한 전이(null -> 'edit'만 허용)까지는 강제하지 않는다 — 작가가 자기
      // 팩의 pending 플래그를 스스로 지우는 것 자체는 검토를 우회하는 게
      // 아니라서(라이브 상태엔 영향 없음) 규칙을 단순하게 유지하는 쪽을 택했다.
      //
      // title/genres/description/coverImageId는 이 규칙에서 값 자체를 검사하지
      // 않는다 — draft 필드라 작가가 언제든 자유롭게 고칠 수 있어야 하고, 그걸
      // 막는 건 liveMetadata(위에서 잠가 둔) 쪽이다. price/salePrice/
      // discountStartAt/discountEndAt도 정확히 같은 대우다 — 여기서 따로 막지
      // 않는다(자유롭게 draft로 고칠 수 있다), 대신 effectivePrice()가 오직
      // liveMetadata만 읽으므로 admin 승인 전까지는 독자에게도, 무료 판정에도
      // 전혀 영향을 주지 않는다.
      //
      // authorId/type/serializationStatus는 여기서도 점(.) 표기 대신
      // get(key, null)을 쓴다 — AdminStoryPack 클래스 doc에 적혀 있듯 예전에
      // 만들어진 팩(예: 좀비 이야기 팩)은 authorId/type/genres가 아예 없는
      // 채로 남아있을 수 있고, 그런 문서에 점 표기로 접근하면(authorApplications
      // 규칙에 이미 있는 것과 같은 문제) "속성을 찾을 수 없음" 에러로 요청
      // 전체가 permission-denied로 거부된다 — 실제로 겪은 버그다(가격 필드가
      // 아직 없는 신규/구형 팩만 메타데이터 승인이 막혔던 원인).
      // pendingMetadataAction을 'edit'로 만드는 요청(requestMetadataEdit)은
      // 이 문서가 이미 serializationStatus == 'approved'일 때만 허용한다 —
      // AdminStoryPack.canRequestMetadataEdit이 같은 조건을 요구하지만 그건
      // UI(버튼 노출)에서만 강제되던 값이라, 그 조건을 안 타는 직접 쓰기(예:
      // 콘솔에서 손으로 만든 테스트 문서)로 draft 상태 팩에 pendingMetadataAction:
      // 'edit'가 남을 수 있었다 — 연재 시작 승인을 한 번도 못 받아 liveMetadata
      // 자체가 없는 팩이 "메타데이터 수정 승인" 대기열에 잘못 들어가는 상태
      // 자체를 여기서 막는다.
      allow update: if isSignedIn() && resource.data.get('authorId', null) == myUid()
        && request.resource.data.get('authorId', null) == resource.data.get('authorId', null)
        && request.resource.data.get('type', null) == resource.data.get('type', null)
        && request.resource.data.get('authorName', null) == resource.data.get('authorName', null)
        && (request.resource.data.get('serializationStatus', null) == resource.data.get('serializationStatus', null)
            || request.resource.data.get('serializationStatus', null) == 'pending')
        && (request.resource.data.get('pendingMetadataAction', null) != 'edit'
            || resource.data.get('serializationStatus', null) == 'approved')
        && request.resource.data.get('liveMetadata', null) == resource.data.get('liveMetadata', null)
        && request.resource.data.get('serializationReviewedBy', null) == resource.data.get('serializationReviewedBy', null)
        && request.resource.data.get('serializationReviewedAt', null) == resource.data.get('serializationReviewedAt', null)
        && request.resource.data.get('metadataReviewedBy', null) == resource.data.get('metadataReviewedBy', null)
        && request.resource.data.get('metadataReviewedAt', null) == resource.data.get('metadataReviewedAt', null);

      // admin의 연재 시작/메타데이터 승인·반려(approveSerialization/
      // rejectSerialization/approveMetadataEdit/rejectMetadataEdit) — 이 네
      // 액션 전부 상태/검토/liveMetadata 필드만 바꾸고, 작가가 쓴
      // title/genres/description/coverImageId/price/salePrice/discountStartAt/
      // discountEndAt/defaultBgmId 자체는 건드리지 않는다(반려 시 작가가
      // 재신청 때 그대로 다시 손볼 수 있어야 한다). defaultBgmId는
      // defaultBackgroundImage와 달리 여기 잠금 목록에 들어간다 — "지금부터
      // 뭐가 재생될지"는 liveMetadata 승인 게이트를 그대로 거치는 콘텐츠라는
      // 판단(admin_story_pack.dart의 AdminStoryPack.defaultBgmId doc 참고).
      // 전부 get(key, null)로 접근한다 — 위와 같은 이유(예전 팩은 이 필드들이
      // 아예 없을 수 있다).
      allow update: if isAdmin()
        && request.resource.data.get('title', null) == resource.data.get('title', null)
        && request.resource.data.get('genres', null) == resource.data.get('genres', null)
        && request.resource.data.get('description', null) == resource.data.get('description', null)
        && request.resource.data.get('coverImageId', null) == resource.data.get('coverImageId', null)
        && request.resource.data.get('price', null) == resource.data.get('price', null)
        && request.resource.data.get('salePrice', null) == resource.data.get('salePrice', null)
        && request.resource.data.get('discountStartAt', null) == resource.data.get('discountStartAt', null)
        && request.resource.data.get('discountEndAt', null) == resource.data.get('discountEndAt', null)
        && request.resource.data.get('defaultBgmId', null) == resource.data.get('defaultBgmId', null)
        // defaultTtsVoiceId도 defaultBgmId와 같은 대우 — liveMetadata 게이트를
        // 타는 draft 필드라 admin의 승인/반려 액션(상태/liveMetadata/검토 필드만
        // 바꿔야 하는 액션)에서는 절대 같이 바뀌면 안 된다.
        && request.resource.data.get('defaultTtsVoiceId', null) == resource.data.get('defaultTtsVoiceId', null)
        && request.resource.data.get('authorId', null) == resource.data.get('authorId', null);

      // 리더가 리더 화면을 열 때(InteractiveReader/LinearReader, 리딩 세션당
      // 한 번) viewCount를 딱 +1만 하는 업데이트 — 다른 필드는 절대 같이
      // 못 바꾸고, 값도 정확히 "이전 값 + 1"이어야 한다. 랭킹 스냅샷
      // (rankingSnapshots, functions/src/index.ts의
      // computeDailyRankingSnapshot)의 원천 데이터라 신뢰할 수 있어야 한다.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;

      // admin의 강제 내리기/복원(suspendPack/unsuspendPack/
      // suspendPacksForAuthor) — suspended/suspendedReason/suspendedAt/
      // suspendedBy 네 필드만 바뀔 수 있다. serializationStatus/liveMetadata
      // 승인 흐름과 완전히 독립된 게이트라서(AdminStoryPack.suspended 문서
      // 참고) 이 액션이 그 필드들을 같이 건드릴 이유가 없다. 위 승인/반려
      // 규칙처럼 필드를 하나하나 get(key, null)로 나열하는 대신, 바로 위
      // viewCount 규칙과 같은 방식으로 "이 키들만 바뀔 수 있다" 화이트
      // 리스트를 쓴다 — 나열식 잠금은 나중에 새 필드가 추가될 때마다 이
      // 규칙도 같이 안 고치면 그 필드가 이 액션을 통해 몰래 바뀔 수 있는
      // 구멍이 생기지만, 화이트리스트는 그럴 일이 없다.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['suspended', 'suspendedReason', 'suspendedAt', 'suspendedBy']);

      allow delete: if isAdmin();

      match /nodes/{nodeId} {
        // 읽기 — 작가 본인/admin은 무엇이든(초안 포함) 읽는다. 노드 편집기와
        // 승인 화면이 top-level draft 필드를 그대로 봐야 하기 때문이다.
        //
        // 그 외 로그인 사용자(= 독자)는 **status == 'published'인 문서만**
        // 읽을 수 있다. 이 조건이 리더 쪽 StoryReaderRepository.
        // fetchPublishedNodes()의 쿼리(`.where('status','==','published')`)와
        // 정확히 일치하기 때문에 그 쿼리는 그대로 통과한다 — Firestore는
        // 규칙을 필터로 쓰지 않고(rules are not filters) "쿼리 제약만으로
        // 규칙이 만족됨이 증명되는가"를 보므로, 쿼리가 제약하지 않는 필드를
        // 규칙이 참조하면 쿼리 전체가 거부된다. 여기서는 status를 점(.)
        // 표기로 직접 읽는 게 의도적이다 — get('status', ...)로 감싸면 그
        // 증명이 성립하지 않을 수 있다. status는 AdminStoryNode.
        // toFirestoreJson()이 항상 써 넣으므로 누락될 일이 없고, 만에 하나
        // 없는 문서가 있어도 결과는 "거부"라 안전한 쪽으로 실패한다.
        //
        // ⚠️ 이 조건이 막는 것과 못 막는 것을 정확히 알아둘 것:
        //  - 막는다: 한 번도 발행된 적 없는 순수 초안(status == 'draft')이
        //    독자에게 새는 것.
        //  - 못 막는다(구조적 한계): 이미 발행된 노드를 작가가 수정 중일 때의
        //    **미승인 초안**. saveNode()가 문서 전체를 set하므로 그 초안은
        //    같은 문서의 top-level 필드에 들어가는데 status는 'published'로
        //    남는다. Firestore 규칙은 문서 단위 전부-아니면-전무라 필드 단위
        //    투영이 불가능하다 — 이걸 진짜로 막으려면 draft와 live를 서로 다른
        //    문서로 쪼개야 한다(스키마 변경, 별도 작업).
        //  - 못 막는다(별도 경로): 유료 팩의 **발행된** 본문. 아래
        //    {path=**}/nodes 재귀 규칙 주석 참고 — 그쪽이 진짜 구멍이다.
        allow read: if isPackOwnedBy(packId) || isAdmin()
          || (isSignedIn() && resource.data.status == 'published');

        // 작가 자신의 저장(임시저장/승인요청 제출, saveNode) — status/liveSnapshot은
        // 절대 못 건드린다. 이 두 필드는 오직 admin의 승인/반려에서만 바뀐다.
        allow create: if (isPackOwnedBy(packId) || isAdmin())
          && request.resource.data.status == 'draft'
          && request.resource.data.liveSnapshot == null
          && request.resource.data.pendingAction in ['create', null];

        // rejectionReason은 여기서도 안 잠근다 — 작가가 반려된 노드를 고쳐
        // 다시 제출할 때(requestApprovalForNode) 이 필드를 null로 지우는
        // 것도 바로 이 규칙(작가 본인 update)을 통과해야 한다.
        // ttsAudioUrl/ttsAudioGeneratedForBodyHash는 synthesizeNodeTts(Cloud
        // Function, Admin SDK로 이 규칙 자체를 우회해 쓴다)만 채우는 서버 캐시
        // 필드다 — 여기서 잠가 두지 않으면 악의적인 클라이언트가 이 두 필드를
        // 임의로 바꿔 다른(공격자가 준비한) 오디오를 모든 독자에게 대신
        // 들려줄 수 있다. 정상적인 작가 클라이언트는 항상 자기가 읽은 값을
        // 그대로 다시 써 넣으므로(admin_story_node.dart의 toFirestoreJson()
        // doc 참고) 이 잠금이 정상 흐름을 막지 않는다.
        allow update: if (isPackOwnedBy(packId) || isAdmin())
          && request.resource.data.status == resource.data.status
          && request.resource.data.liveSnapshot == resource.data.liveSnapshot
          && request.resource.data.get('ttsAudioUrl', null) == resource.data.get('ttsAudioUrl', null)
          && request.resource.data.get('ttsAudioGeneratedForBodyHash', null) == resource.data.get('ttsAudioGeneratedForBodyHash', null)
          // ttsPreviewAudioUrl/ttsPreviewAudioGeneratedForBodyHash도 같은
          // 이유로 잠근다 — previewNodeTts(Admin SDK)만 쓴다. 잠그지 않으면
          // 저자가 이 두 필드를 직접 조작해(해시를 승인될 콘텐츠의 실제
          // 해시와 맞춰서) 임의의 오디오를 심어 둘 수 있고, 승인 시점에
          // onNodeApprovedGenerateTts가 그 파일을 검증 없이 그대로
          // ttsAudioUrl로 승격해 모든 독자에게 재생하게 된다.
          && request.resource.data.get('ttsPreviewAudioUrl', null) == resource.data.get('ttsPreviewAudioUrl', null)
          && request.resource.data.get('ttsPreviewAudioGeneratedForBodyHash', null) == resource.data.get('ttsPreviewAudioGeneratedForBodyHash', null);

        // admin의 승인/반려(approveNode/rejectNode) — status/liveSnapshot/
        // pendingAction/rejectionReason만 바뀌고 콘텐츠 필드는 그대로 둔다.
        // rejectionReason(반려 사유, 작가 쪽 사이드바/편집 화면에 그대로
        // 보여준다 — node_editor.dart/status_tag.dart)은 아래 목록에 없는
        // 필드라 이 규칙이 자유롭게 바뀌도록 이미 허용한다 — 이 규칙은
        // "콘텐츠 필드는 그대로여야 한다"만 검사하지 "이 필드들 외에는 아무것도
        // 못 바꾼다"는 화이트리스트가 아니기 때문이다. approveNode가 승인 시
        // rejectionReason을 null로 지우는 것, rejectNode가 반려 시 admin이
        // 입력한 사유를 써 넣는 것 둘 다 이 규칙 그대로 통과한다.
        //
        // ⚠️ 예전엔 이 규칙이 title/day/body/bgImageId라는 blocks 스키마
        // 마이그레이션 이전 필드명을 점(.) 표기로 비교했다 — 그 필드들은
        // 마이그레이션 후 어떤 노드 문서에도 아예 존재하지 않아서(현재
        // 필드는 AdminStoryNode.contentSnapshot() 참고: order/blocks/
        // backgroundImage/backgroundAppliesForward/choices/nextNodeId/effects),
        // 점 표기 접근 자체가 매번 "속성을 찾을 수 없음" 에러로 터져서
        // approveNode/rejectNode가 전부 permission-denied로 실패했다 —
        // storyPacks 문서 레벨(title/genres/description/price 등)에서 이미
        // 두 번 겪은 것과 완전히 같은 문제 패턴이다. 지금은 실제 현재
        // 필드명을 get(key, null)로 안전하게 비교한다.
        allow update: if isAdmin()
          && request.resource.data.get('order', null) == resource.data.get('order', null)
          && request.resource.data.get('blocks', null) == resource.data.get('blocks', null)
          && request.resource.data.get('backgroundImage', null) == resource.data.get('backgroundImage', null)
          && request.resource.data.get('backgroundAppliesForward', null) == resource.data.get('backgroundAppliesForward', null)
          && request.resource.data.get('choices', null) == resource.data.get('choices', null)
          && request.resource.data.get('nextNodeId', null) == resource.data.get('nextNodeId', null)
          && request.resource.data.get('effects', null) == resource.data.get('effects', null)
          // 위 update 규칙(작가 본인)과 같은 이유로 여기서도 잠근다 — approveNode/
          // rejectNode도 이 네 필드를 절대 건드리지 않는다(ttsAudioUrl/hash는
          // 승인 후 onNodeApprovedGenerateTts가, ttsPreviewAudioUrl/hash는
          // previewNodeTts가 각자 Admin SDK로만 쓴다).
          && request.resource.data.get('ttsAudioUrl', null) == resource.data.get('ttsAudioUrl', null)
          && request.resource.data.get('ttsAudioGeneratedForBodyHash', null) == resource.data.get('ttsAudioGeneratedForBodyHash', null)
          && request.resource.data.get('ttsPreviewAudioUrl', null) == resource.data.get('ttsPreviewAudioUrl', null)
          && request.resource.data.get('ttsPreviewAudioGeneratedForBodyHash', null) == resource.data.get('ttsPreviewAudioGeneratedForBodyHash', null);

        // 삭제: 작가는 한 번도 발행된 적 없는(liveSnapshot == null) 자기 노드만
        // 즉시 지울 수 있다(deleteNodeDoc). 이미 발행된 노드의 삭제는 admin이
        // 삭제 요청을 승인(approveNode)하는 경로로만 이뤄진다.
        allow delete: if (isPackOwnedBy(packId) && resource.data.liveSnapshot == null) || isAdmin();
      }

      // reviews/{uid} — 문서 id가 곧 작성자 uid라서 "유저 하나당 리뷰 하나"가
      // 스키마로 강제된다(재작성 = 같은 문서 update). rating/text 갱신 자체는
      // 클라이언트가 하지만, storyPacks 문서의 avgRating/reviewCount 집계는
      // Cloud Function(functions/src/index.ts, Admin SDK로 규칙을 우회해
      // 쓴다)만 건드린다 — 여기 규칙은 그 두 필드를 클라이언트가 못 쓰게
      // 막을 필요조차 없다(애초에 storyPacks 문서 update 규칙 어디에도
      // avgRating/reviewCount를 허용한 적이 없다).
      match /reviews/{reviewId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() && reviewId == myUid() && canReviewPack(packId)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

        // 수정: 본인 리뷰만, createdAt은 절대 못 바꾼다(최초 작성 시각 보존).
        allow update: if isSignedIn() && reviewId == myUid() && canReviewPack(packId)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // comments/{commentId} — 문서 id는 자동 생성(한 유저가 여러 개 남길 수
      // 있어서 reviews처럼 uid로 고정할 수 없다), 그래서 uid를 필드로 저장한다.
      // parentCommentId(null이면 최상위, 아니면 부모 댓글 id — 답글은 딱 한
      // 단계만, isValidParentComment가 강제)와 likeCount(Cloud Function
      // onCommentLikeWritten만 갱신) 둘 다 update 시점에 고정된다. 삭제는
      // 소프트 삭제(isDeleted)뿐이고, 그마저도 본인 댓글만, 그 필드 하나만
      // 바꿀 수 있다(그 외 필드는 update 요청에서도 전부 원래 값과 같아야
      // 한다 — 사실상 "삭제 표시"만 허용).
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() && canReviewPack(packId)
          && request.resource.data.uid == myUid()
          && request.resource.data.isDeleted == false
          && request.resource.data.get('likeCount', 0) == 0
          && (
            request.resource.data.get('parentCommentId', null) == null
            || isValidParentComment(packId, request.resource.data.parentCommentId)
          );

        allow update: if isSignedIn() && resource.data.uid == myUid()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.text == resource.data.text
          && request.resource.data.authorDisplayName == resource.data.authorDisplayName
          && request.resource.data.authorPhotoUrl == resource.data.authorPhotoUrl
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('parentCommentId', null) == resource.data.get('parentCommentId', null)
          && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0)
          && request.resource.data.isDeleted == true;

        // likes/{uid} — 문서 존재 = 좋아요. 본인 uid 경로만 만들고 지울 수
        // 있다. likeCount 집계 자체는 Cloud Function(Admin SDK)의 몫이라
        // 여기 규칙과 무관하다.
        match /likes/{uid} {
          allow read: if isSignedIn();
          allow create, delete: if isSignedIn() && uid == myUid();
        }
      }
    }

    // storyPacks/*/nodes 컬렉션 그룹 조회 전용 규칙 — admin 쪽
    // AdminStoryRepository.watchPendingNodes(collectionGroup('nodes').where
    // ('pendingAction', ...))뿐 아니라, 리더 쪽 StoryPackRepository.
    // watchVisiblePacks()가 "발행된 노드가 있는 팩" 집합을 구하려고 쓰는
    // collectionGroup('nodes').where('status', '==', 'published')도 이 규칙으로
    // 커버된다(firestore.indexes.json에 status 필드의 COLLECTION_GROUP
    // fieldOverrides도 같이 추가했다 — pendingAction 때와 같은 이유).
    //
    // 위 중첩 match(/storyPacks/{packId}/nodes/{nodeId})는 packId를 아는 직접
    // 접근(문서 참조, 특정 팩으로 좁힌 구독)에만 적용되고, collectionGroup()처럼
    // 상위 경로를 모르는 채로 여러 팩을 가로질러 조회하는 쿼리에는 적용되지
    // 않는다 — Firestore는 collection group 쿼리를 오직 {path=**} 형태의
    // 재귀 와일드카드 규칙으로만 허용한다. 이 규칙이 없으면 승인 대기함 탭이
    // permission-denied로 즉시 실패한다(실제로 겪은 버그).
    //
    // 읽기 전용이다 — 쓰기(saveNode/approveNode/rejectNode/deleteNodeDoc)는
    // 전부 직접 문서 참조로만 이뤄지므로 위 중첩 match의 쓰기 규칙만으로 충분하다.
    //
    // 두 갈래로 나뉜다:
    //  - admin: 무엇이든. watchPendingNodes()의 `.where('pendingAction', ...)`
    //    쿼리는 status를 제약하지 않으므로 이 갈래가 없으면 승인 대기함이
    //    통째로 깨진다. isAuthorOrAdmin()이 아니라 isAdmin()인 게 의도적이다 —
    //    이 쿼리를 쓰는 화면(AdminDashboardPage)이 admin 전용이고, author까지
    //    열어주면 남의 팩 초안을 collectionGroup으로 훑을 수 있게 된다.
    //  - 그 외 로그인 사용자: status == 'published'인 문서만. 위 중첩 match의
    //    독자 갈래와 같은 조건이고, 리더 쪽 StoryPackRepository.
    //    _fetchPublishedNodeCounts()의 `.where('status','==','published')`
    //    쿼리와 정확히 일치해 그대로 통과한다.
    //
    // ⚠️ 알려진 미해결 구멍 — 유료 팩 본문이 여기로 샌다.
    // _fetchPublishedNodeCounts()는 홈 화면에서 **모든 팩**의 발행 노드를
    // collectionGroup으로 긁어 와서 팩별 개수를 센다(publishedNodeCount가
    // storyPacks 문서에 비정규화돼 있지 않아서다). 그래서 이 규칙은 구매
    // 여부와 무관하게 모든 독자에게 열려 있어야 하고, 결과적으로 **구매하지
    // 않은 유료 팩의 발행 본문도 SDK로 직접 읽을 수 있다**.
    //
    // 여기서 isPackFree(packId)/readerOwnsPack(packId)로 좁히는 건 애초에
    // 불가능하다 — {path=**}는 상위 경로를 캡처하지 못해서 packId를 알 수 없다.
    //
    // 닫으려면 클라이언트 변경이 필요하다(별도 작업):
    //   1. 노드 쓰기에 반응하는 Cloud Function 트리거로
    //      storyPacks/{packId}.publishedNodeCount를 유지 + 기존 팩 백필,
    //   2. _fetchPublishedNodeCounts()를 없애고 그 필드를 읽게 바꾸고,
    //   3. 그러고 나면 이 규칙을 `allow read: if isAdmin();`으로 좁힐 수 있다,
    //   4. 미리보기는 노드에 previewEligible 플래그를 승인 시점에 찍고
    //      리더가 2단계로(미리보기분 → 구매 후 전체) 나눠 읽게 한다.
    // 자세한 내용은 doc/codebase_audit.md 참고.
    match /{path=**}/nodes/{nodeId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.status == 'published');
    }

    // =========================================================================
    // 공유 미디어 라이브러리 — images/sfxLibrary/bgmLibrary는 전부 "Firestore
    // 문서는 색인일 뿐이고 실제 파일은 Storage에 있다"는 같은 구조다. 셋 다
    // 팩별이 아니라 **모든 작가가 공유**한다(FIRESTORE_SCHEMA.md 참고).
    //
    // ⚠️ 여기서 잠그는 건 색인 문서지 파일이 아니다. Storage 쪽 규칙은
    // 저장소 루트의 storage.rules(PR #5에서 추가)가 관리한다 — 다만 그
    // 규칙도 Firebase download-token URL에는 적용되지 않는다(토큰 URL은
    // 규칙을 우회한다). 그래서 이 색인 문서들의 read를 좁히는 게 의미가
    // 있다: 문서 안에 그 장기 token URL이 그대로 들어 있기 때문이다.
    // =========================================================================

    // images/{imageId} — 색인 문서. 실제 파일은 Storage에 있다.
    // 업로더를 추적하는 필드가 아직 없어 모든 author/admin이 공유하는
    // 라이브러리다 — uploaderId가 생기면 그때 좁힐 수 있다.
    // 카테고리 변경은 author/admin에게 허용하되, 이 액션으로 URL/이름 등
    // 다른 필드를 건드릴 수 없도록 category 한 필드만 화이트리스트로 연다.
    //
    // ⚠️ read를 isAuthorOrAdmin()으로 좁히지 **못한다**(sfxLibrary/bgmLibrary는
    // 좁혔다). doc/private_media_firestore_rules.patch.md는 세 컬렉션을 전부
    // 좁히라고 하지만, 그 문서는 리더 경로로 StoryReaderRepository 하나만
    // 확인했다. 실제로는 카탈로그도 이 컬렉션을 직접 읽는다:
    //
    //   StoryPackRepository._fetchImageUrls()
    //     ← _toVisiblePacks()  (watchVisiblePacks — 홈 탭 전체 표지)
    //     ← fetchPacksByIds()  (번들 카드 표지)
    //
    // 둘 다 순수 독자 경로이고 **표지 이미지**를 읽는다. 여기서 read를 좁히면
    // 모든 독자의 홈 탭 표지가 통째로 깨진다 — 보안이 좋아지는 게 아니라
    // 카탈로그가 죽는다. 표지는 애초에 공개 정보라(무엇을 파는지 보여줘야
    // 한다) 이 컬렉션에 남은 노출은 "표지 URL이 로그인 사용자에게 보인다"
    // 수준이다.
    //
    // 제대로 닫으려면 표지도 resolveStoryMedia 같은 서버 게이트를 타거나,
    // 표지 URL만 storyPacks.liveMetadata에 비정규화해서 카탈로그가 images를
    // 아예 안 읽게 만들어야 한다 — 별도 작업이다.
    match /images/{imageId} {
      allow read: if isSignedIn();
      allow create, delete: if isAuthorOrAdmin();
      allow update: if isAuthorOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category']);
    }

    // sfxLibrary/{sfxId} — images와 같은 패턴의 색인 문서(실제 파일은 Storage
    // admin/story_sfx/{sfxId}.mp3에 있다). 이 규칙이 아예 없어서 모든 읽기가
    // 기본값(거부)으로 막혀 있었다 — 리더가 노드를 열 때 StoryReaderRepository.
    // fetchPublishedNodes()가 sfxLibrary를 조인 조회하면서 로그인 여부와 무관하게
    // 매번 permission-denied가 났다(실제로 겪은 버그).
    // 카테고리 변경은 images와 동일하게 category 필드 하나만 허용한다.
    //
    // read를 isAuthorOrAdmin()으로 좁혔다(doc/private_media_firestore_rules.patch.md).
    // 위에 적힌 "리더가 sfxLibrary를 조인 조회한다"는 건 **더 이상 사실이
    // 아니다** — PR #4에서 StoryReaderRepository가 resolveStoryMedia Cloud
    // Function을 거치도록 바뀌면서 이 컬렉션을 직접 읽지 않는다(lib/ 전체를
    // grep해서 확인함: admin 3개 저장소 외에 sfxLibrary/bgmLibrary를 읽는
    // 코드가 없다). 이 문서에 남아 있는 장기 download-token URL이 독자에게
    // 노출되지 않도록 닫는다.
    match /sfxLibrary/{sfxId} {
      allow read: if isAuthorOrAdmin();
      allow create, delete: if isAuthorOrAdmin();
      allow update: if isAuthorOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category']);
    }

    // bgmLibrary/{bgmId} — sfxLibrary와 같은 패턴의 색인 문서(실제 파일은
    // Storage admin/story_bgm/{bgmId}.mp3에 있다 — Storage 규칙은 이제
    // 저장소 루트의 storage.rules가 관리한다, PR #5). update는 없다 —
    // sfxLibrary와 달리 category 같은 사후 수정 가능한 필드가 아예 없어서
    // (admin_bgm.dart), 업로드/삭제 둘로 충분하다.
    //
    // read는 sfxLibrary와 같은 이유로 isAuthorOrAdmin()으로 좁혔다 — 리더는
    // resolveStoryMedia를 통해서만 BGM URL을 받는다.
    match /bgmLibrary/{bgmId} {
      allow read: if isAuthorOrAdmin();
      allow create, delete: if isAuthorOrAdmin();
    }

    // ttsVoiceCache/typecast — Typecast 보이스 목록을 캐시해 둔 문서 하나.
    // sfxLibrary/bgmLibrary처럼 개별 항목마다 문서가 있는 게 아니라
    // {voices: [...]} 배열 하나짜리 문서다(admin_tts_voice_repository.dart
    // 참고). 클라이언트는 절대 직접 안 쓴다 — refreshTypecastVoiceCacheScheduled
    // (매일 자동)/refreshTypecastVoices(수동 새로고침 Cloud Function) 둘 다
    // Admin SDK로 써서 이 규칙 자체를 우회한다. write를 아예 허용하지 않는다.
    match /ttsVoiceCache/{voiceCacheId} {
      allow read: if isAuthorOrAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 공지 · 운영 로그
    // =========================================================================

    // writerNotices/{noticeId} — 작가가 **자기 팩에** 올리는 변경사항 공지.
    // packId 필드로 어느 팩 것인지 가리킨다(플랫폼 전체 공지인 notices와는
    // 완전히 다른 컬렉션이다 — 위 notices 주석 참고).
    //
    // 읽기는 로그인한 누구나(독자가 팩 상세에서 본다). 쓰기는 그 팩의 작가
    // 본인이거나 admin일 때만 — isPackOwnedBy()가 create는 들어오는 문서의
    // packId로, delete는 이미 저장된 문서의 packId로 소유권을 확인한다.
    // update가 없는 건 의도다: 공지는 고치는 게 아니라 지우고 다시 올린다.
    match /writerNotices/{noticeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isPackOwnedBy(request.resource.data.packId);
      allow delete: if isAdmin() || isPackOwnedBy(resource.data.packId);
    }

    // activityLog/{eventId} — 관리자 개요의 "최근 활동" 타임라인이자 승인
    // 대기함의 "처리 이력" 원천. 이 프로젝트에서 드물게 **Cloud Functions가
    // 아니라 admin 클라이언트가 직접 쓰는** 감사 로그다(승인/반려/상품 수정/
    // 배너 게시가 전부 이미 admin 클라이언트의 쓰기라, 같은 동작을 서버에서
    // 다시 감지할 이유가 없다는 판단 — ActivityLogRepository 문서 참고).
    //
    // 그래서 읽기도 쓰기도 admin만. update/delete를 막아 append-only로 둔다 —
    // 감사 로그가 사후에 고쳐지면 감사 로그가 아니다.
    //
    // 예외: setAuthorAccountDisabled Cloud Function은 계정 정지/해제 건을
    // 서버에서 직접 남긴다(Admin SDK라 이 규칙을 우회한다).
    match /activityLog/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
